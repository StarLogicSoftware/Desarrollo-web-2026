---
import Menu from "../components/menu.astro";
import FooterPetacular from "../components/footer.astro";

const { titulo, desc } = Astro.props
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{titulo}</title>
	</head>
	<body>
		<Menu tituloBarra={desc}/>

		<slot />
		<!-- Esto viene a ser el contenido de cualquier pagina -->

		<FooterPetacular />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
